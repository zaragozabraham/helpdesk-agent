# HTTP server (src/config.ts)
PORT=3000
HOST=127.0.0.1

# Langfuse: Cloud (https://cloud.langfuse.com EU, https://us.cloud.langfuse.com US)
# or self-hosted (http://localhost:3100). See README.
LANGFUSE_SECRET_KEY=XXXXX
LANGFUSE_PUBLIC_KEY=XXXXX
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM (local Ollama). Default model per ADR-001.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434