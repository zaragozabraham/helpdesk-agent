{
	"name": "helpdesk-agent",
	"version": "0.0.0",
	"private": true,
	"description": "Technical-support agent built release by release with LangChain v1 / LangGraph v1.",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"dev": "tsx watch src/server/index.ts",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"hello": "node --env-file-if-exists=.env --import tsx scripts/hello.ts"
	},
	"author": "AZ",
	"license": "MIT",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.14.0",
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.20.5",
		"eslint": "^10.14.0",
		"lefthook": "^2.2.2",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@langchain/core": "^1.3.5",
		"@langchain/ollama": "^1.3.0",
		"@langfuse/core": "^6.1.1",
		"@langfuse/langchain": "^6.1.1",
		"@langfuse/otel": "^6.1.1",
		"@opentelemetry/sdk-node": "^0.301.0",
		"fastify": "^5.12.8",
		"langchain": "^1.6.2",
		"zod": "^4.6.7"
	}
}
